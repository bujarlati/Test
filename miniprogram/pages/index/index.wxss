.page {
  min-height: 100vh;
  padding: 14px 14px 18px;
  background: #10251c;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.brand {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}

.title {
  font-size: 22px;
  font-weight: 700;
  color: #f6ead0;
}

.status {
  font-size: 12px;
  color: #b7cbb8;
}

.status.offline {
  color: #ffad8a;
}

.currency {
  flex: none;
  min-width: 72px;
  padding: 7px 10px;
  border: 1px solid rgba(255, 207, 90, 0.45);
  border-radius: 6px;
  color: #ffcf5a;
  font-size: 14px;
  font-weight: 700;
  text-align: center;
  background: rgba(45, 36, 21, 0.58);
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1.45fr 1fr 1fr;
  gap: 8px;
  margin-top: 12px;
}

.stat,
.detail-stat {
  min-width: 0;
  padding: 8px;
  border: 1px solid rgba(227, 214, 169, 0.18);
  border-radius: 6px;
  background: rgba(20, 39, 31, 0.78);
}

.label {
  display: block;
  color: #a6b9a9;
  font-size: 11px;
}

.value {
  display: block;
  margin-top: 2px;
  color: #f4f0df;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}

.canvas-shell {
  width: 100%;
  height: 338px;
  margin-top: 12px;
  overflow: hidden;
  border: 1px solid rgba(235, 220, 171, 0.24);
  border-radius: 8px;
  background: #203d35;
}

.game-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.actions,
.modal-actions {
  display: flex;
  gap: 8px;
  margin-top: 10px;
}

.action,
.modal-action {
  flex: 1;
  height: 34px;
  line-height: 34px;
  padding: 0;
  border: 0;
  color: #17231e;
  font-size: 13px;
  font-weight: 700;
  background: #ffcf5a;
}

.action.ghost,
.modal-action.secondary {
  color: #f4f0df;
  background: rgba(236, 229, 205, 0.14);
}

.panels {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 12px;
}

.panel {
  min-width: 0;
}

.panel-title {
  margin-bottom: 7px;
  color: #f6ead0;
  font-size: 14px;
  font-weight: 700;
}

.list {
  height: 132px;
  padding-right: 2px;
}

.item {
  margin-bottom: 7px;
  padding: 8px;
  border-left: 3px solid #d8dde4;
  border-radius: 6px;
  background: rgba(246, 240, 223, 0.08);
}

.item-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.item-name {
  min-width: 0;
  color: #f4f0df;
  font-size: 12px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-score,
.price {
  flex: none;
  color: #dccb94;
  font-size: 11px;
}

.price {
  color: #ffcf5a;
  font-weight: 700;
}

.item-sub,
.empty,
.hint {
  margin-top: 4px;
  color: #9fb3a2;
  font-size: 11px;
  line-height: 1.35;
}

.event {
  margin-bottom: 6px;
  padding: 7px 8px;
  border-radius: 6px;
  color: #cfe2d2;
  font-size: 11px;
  line-height: 1.35;
  background: rgba(246, 240, 223, 0.08);
}

.event.loot {
  color: #ffcf5a;
}

.event.level_up {
  color: #8ee6ac;
}

.rarity-white {
  border-left-color: #d8dde4;
}

.rarity-green {
  border-left-color: #36b37e;
}

.rarity-blue {
  border-left-color: #2684ff;
}

.rarity-purple {
  border-left-color: #9b5cff;
}

.rarity-gold {
  border-left-color: #ffab00;
}

.rarity-red {
  border-left-color: #ff4d4f;
}

.modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  padding: 14px;
  background: rgba(8, 14, 12, 0.62);
}

.modal-card {
  width: 100%;
  padding: 14px;
  border-left: 4px solid #d8dde4;
  border-radius: 8px;
  background: #183226;
  box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.28);
}

.modal-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.modal-title-wrap {
  min-width: 0;
}

.modal-title {
  display: block;
  color: #f6ead0;
  font-size: 16px;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-sub {
  display: block;
  margin-top: 3px;
  color: #a6b9a9;
  font-size: 12px;
}

.icon-button {
  flex: none;
  width: 30px;
  height: 30px;
  line-height: 28px;
  padding: 0;
  border: 1px solid rgba(246, 240, 223, 0.18);
  color: #f4f0df;
  background: rgba(246, 240, 223, 0.08);
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  margin-top: 12px;
}

.price-row {
  display: flex;
  flex: 1.6;
  gap: 8px;
}

.price-input {
  flex: 1;
  height: 34px;
  min-width: 0;
  padding: 0 10px;
  border: 1px solid rgba(255, 207, 90, 0.34);
  border-radius: 6px;
  color: #ffcf5a;
  font-size: 13px;
  background: rgba(16, 25, 22, 0.72);
}

.listing-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: #cfe2d2;
  font-size: 12px;
}

@media (max-width: 360px) {
  .stats,
  .detail-grid {
    grid-template-columns: 1fr 1fr;
  }

  .canvas-shell {
    height: 300px;
  }

  .panels {
    grid-template-columns: 1fr;
  }

  .list {
    height: 112px;
  }

  .modal-actions,
  .price-row {
    flex-direction: column;
  }
}
